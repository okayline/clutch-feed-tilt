{
  // TILT.EXE. The Worker's name must match the one in the Cloudflare dashboard.
  "name": "clutch-feed-tilt",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // The site's files (index.html etc). /api/* goes to the Worker code first.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "cft.88x31.app", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cft-db",
      "database_id": "c901f5df-a8cc-4ce2-afd9-774282c20d52"
    },
    // 4Dungeon's board, read only: how far its players have opened the quarter's floor (wingsOpened in src/worker.js)
    {
      "binding": "DUNGEON",
      "database_name": "daily-dungeon-board",
      "database_id": "a6dedccb-27e0-4988-84ea-64c7cd71c0ee"
    }
  ],
  // the shared save codes and passkeys (the dungeon-items Worker, `Accounts` entrypoint; see its ACCOUNTS.md)
  "services": [
    { "binding": "ACCOUNTS", "service": "dungeon-items", "entrypoint": "Accounts" },
    // the shared registry's ledger: every sealed run sends it a checkpoint (see checkpoint() in src/worker.js)
    { "binding": "REGISTRY", "service": "dungeon-items", "entrypoint": "Registry" }
  ],
  "vars": {
    // requests to any *.workers.dev address are sent here instead (passkeys belong to 88x31.app addresses)
    "CANONICAL_HOST": "cft.88x31.app"
  }
}
